# ==============================================================================
# Environment Configuration Template
# Copy this file to .env before running locally or with Docker Compose
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=aifinance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_dev
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Spring Boot Backend Configuration
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Python FastAPI AI Service Configuration
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0

# React Vite Frontend Configuration
FRONTEND_PORT=3000
# VITE_BACKEND_URL=https://api.example.com
# VITE_AI_SERVICE_URL=https://ai.example.com

# AI / LLM Configuration (Placeholders for Phase 5+)
GROQ_API_KEY=your_groq_api_key_here
AI_MODEL=openai/gpt-oss-120b
