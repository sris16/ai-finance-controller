{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Settlements CSV Schema",
  "type": "object",
  "description": "Schema for settlements.csv",
  "properties": {
    "settlement_id": {
      "type": "string",
      "description": "Unique identifier for the settlement"
    },
    "payment_id": {
      "type": "string",
      "description": "Identifier for the associated payment (Foreign Key to payments.payment_id)"
    },
    "settlement_date": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the settlement occurred"
    },
    "gross_amount": {
      "type": "number",
      "minimum": 0,
      "description": "Gross amount of the payment"
    },
    "fee": {
      "type": "number",
      "minimum": 0,
      "description": "Gateway fee applied"
    },
    "net_amount": {
      "type": "number",
      "minimum": 0,
      "description": "Net amount settled (gross_amount - fee)"
    },
    "status": {
      "type": "string",
      "description": "Status of the settlement"
    }
  },
  "required": ["settlement_id", "payment_id", "settlement_date", "gross_amount", "fee", "net_amount", "status"],
  "additionalProperties": false
}
